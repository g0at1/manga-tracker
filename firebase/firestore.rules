rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A library is reachable only by its 24-character key; the top-level
    // collection can't be listed, so keys can't be discovered.
    match /libraries/{libraryKey} {
      // The library document holds the e-mail reminder settings under
      // `reminders`. `reminderLog` on the same document is written by the
      // Cloud Functions only, so clients may touch nothing but `reminders`.
      // No `list` here: `get` needs the key.
      allow get: if libraryKey.size() == 24;
      allow create: if libraryKey.size() == 24
        && request.resource.data.keys().hasOnly(['reminders']);
      allow update: if libraryKey.size() == 24
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reminders']);
      allow delete: if libraryKey.size() == 24;

      match /mangas/{mangaId} {
        allow read, write: if libraryKey.size() == 24;
      }
    }
  }
}
